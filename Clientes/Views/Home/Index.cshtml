@model List<ClienteModel>
@{
    ViewData["Title"] = "Clientes";
    var tipos = ViewBag.Tipos as List<TipoCuenta> ?? new List<TipoCuenta>();
    var total = Model?.Count ?? 0;
}

<div class="page-shell">
    <section class="toolbar-panel mt-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="section-title mb-0">Listado de Clientes</h2>
            <div class="hero-stats d-flex">
                <div class="stat-card mr-3">
                    <span class="stat-label">Total:</span>
                    <strong>@total</strong>
                </div>
            </div>
        </div>
        <div class="toolbar-search">
            <label class="toolbar-label" for="searchText">Buscar cliente</label>
            <div class="toolbar-row">
                <input class="form-control form-control-lg" onkeyup="UnifiedSearch()" type="search" id="searchText" placeholder="Buscar por nombre, cuenta o comentario">
            </div>
        </div>

        <div class="toolbar-actions">
            <select id="filtroTipo" class="form-control form-control-lg" onchange="filtrarPorTipo()" style="min-width: 200px;">
                <option value="0">Todos los tipos</option>
                @foreach (var tipo in tipos.OrderBy(t => t.Nombre))
                {
                    <option value="@tipo.Id">@tipo.Nombre</option>
                }
            </select>
            <button type="button" onclick="MostrarTodas()" class="btn btn-outline-secondary btn-lg">Todas</button>
            <button type="button" onclick="cuentasLibre()" class="btn btn-outline-success btn-lg">Libres</button>
        </div>
    </section>

    <button type="button" onclick="agregar()" class="btn-floating" title="Nuevo cliente">
        <i class="fas fa-plus"></i>
    </button>

    <section class="table-card shadow-sm">
        <div class="table-responsive">
            <table id="customers" class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th scope="col" data-sort="TipoNombre">Tipo <i class="fas fa-sort"></i></th>
                        <th scope="col" data-sort="Nombre">Nombre <i class="fas fa-sort"></i></th>
                        <th scope="col" data-sort="Cuenta">Cuenta <i class="fas fa-sort"></i></th>
                        <th scope="col" data-sort="Contraseña">Contraseña <i class="fas fa-sort"></i></th>
                        <th scope="col" data-sort="VencimientoC">Vencimiento cuenta <i class="fas fa-sort"></i></th>
                        <th scope="col" data-sort="VencimientoP">Vencimiento cliente <i class="fas fa-sort"></i></th>
                        <th scope="col" data-sort="Pantallas">Pantallas <i class="fas fa-sort"></i></th>
                        <th scope="col" data-sort="Comentario">Comentario <i class="fas fa-sort"></i></th>
                        <th scope="col" class="action-col action-danger">Borrar</th>
                        <th scope="col" class="action-col action-primary">Editar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model ?? new List<ClienteModel>())
                    {
                        <tr id="@item.Id" class="DataRows">
                            <td>@item.TipoNombre</td>
                            <td>@item.Nombre</td>
                            <td>@item.Cuenta</td>
                            <td>@item.Contraseña</td>
                            <td>@item.VencimientoC</td>
                            <td>@item.VencimientoP</td>
                            <td>@item.Pantallas</td>
                            <td>@item.Comentario</td>
                            <td>
                                <button type="button" onclick="Borrar('@item.Id')" class="IconBtn IconBtn-danger" title="Eliminar">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </td>
                            <td>
                                <button type="button" onclick="Editar('@item.Id')" class="IconBtn IconBtn-primary" title="Editar">
                                    <i class="far fa-edit"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
