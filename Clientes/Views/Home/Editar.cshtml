@model Clientes
@{
    ViewData["Title"] = "Editar cliente";
    var tipos = ViewBag.Tipos as List<TipoCuenta> ?? new List<TipoCuenta>();
    var vencimientoP = Model.VencimientoP.HasValue ? Model.VencimientoP.Value.ToString("yyyy-MM-ddTHH:mm") : string.Empty;
    var vencimientoC = Model.VencimientoC.HasValue ? Model.VencimientoC.Value.ToString("yyyy-MM-ddTHH:mm") : string.Empty;
    var tipoActual = Model.Tipo.HasValue ? Model.Tipo.Value : 0;
}

<div class="form-page">
    <div class="form-card card shadow-sm border-0">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-4">
                <div>
                    <p class="eyebrow mb-1">Editar cliente</p>
                    <h1 class="section-title mb-0">Actualizar registro</h1>
                </div>
                <button type="button" onclick="MostrarTodas()" class="btn btn-outline-secondary">Volver</button>
            </div>

            <form class="form-grid">
                <div class="form-group">
                    <label for="Nombre">Nombre</label>
                    <input id="Nombre" type="text" class="form-control form-control-lg" value="@Model.Nombre" placeholder="Nombre">
                </div>

                <div class="form-group">
                    <label for="Email">Email</label>
                    <input id="Email" type="email" class="form-control form-control-lg" value="@Model.Email" placeholder="correo@ejemplo.com">
                </div>

                <div class="form-group">
                    <label for="Cuenta">Cuenta</label>
                    <input id="Cuenta" type="text" class="form-control form-control-lg" value="@Model.Cuenta" placeholder="Cuenta">
                </div>

                <div class="form-group">
                    <label for="Contraseña">Contraseña</label>
                    <input id="Contraseña" type="text" class="form-control form-control-lg" value="@Model.Contraseña" placeholder="Contraseña">
                </div>

                <div class="form-group">
                    <label for="VencimientoC">Fecha de vencimiento de la cuenta</label>
                    <input id="VencimientoC" type="datetime-local" class="form-control form-control-lg" value="@vencimientoC">
                </div>

                <div class="form-group">
                    <label for="VencimientoP">Fecha de vencimiento del cliente</label>
                    <input id="VencimientoP" type="datetime-local" class="form-control form-control-lg" value="@vencimientoP">
                </div>

                <div class="form-group">
                    <label for="Tipo">Tipo</label>
                    <div class="input-group">
                        <select id="Tipo" class="form-control form-control-lg">
                            @if (tipoActual == 0)
                            {
                                <option value="">Seleccionar tipo</option>
                            }
                            @foreach (var tipo in tipos)
                            {
                                if (tipo.Id == tipoActual)
                                {
                                    <option value="@tipo.Id" selected="selected">@tipo.Nombre</option>
                                }
                                else
                                {
                                    <option value="@tipo.Id">@tipo.Nombre</option>
                                }
                            }
                        </select>
                        <div class="input-group-append">
                            <a asp-action="Tipos" class="btn btn-outline-primary d-flex align-items-center" title="Gestionar Tipos">
                                <i class="fas fa-cog"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="Pantallas">Cantidad de pantallas</label>
                    <input id="Pantallas" type="text" class="form-control form-control-lg" value="@Model.Pantallas" placeholder="Pantallas">
                </div>

                <div class="form-group form-group-full">
                    <label for="Comentario">Comentario</label>
                    <textarea id="Comentario" class="form-control form-control-lg" rows="4" placeholder="Comentario">@Model.Comentario</textarea>
                </div>
            </form>

            <div class="form-actions mt-4">
                <button type="button" onclick="EnviarEdicion('@Model.Id')" class="btn btn-primary btn-lg">Guardar cambios</button>
            </div>
        </div>
    </div>
</div>
